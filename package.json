{
  "name": "crowdmap-crowdsource-service",
  "version": "1.1.0",
  "description": "Service for making crowdsourcing Mudlet crowdmaps easier",
  "main": "build/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:review && concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\" \"npm run build:review -- --watch\"",
    "build": "CONFIG_FILE=${CONFIG_FILE:-config.example.yaml} tsoa spec-and-routes && npm run fix:esm-imports && tsc && npm run build:review && cp -R website/ build/",
    "fix:esm-imports": "node scripts/fix-esm-imports.mjs",
    "build:review": "esbuild website/javascripts/review-map.ts --bundle --format=iife --target=es2020 --outfile=website/javascripts/review-map.js",
    "start": "node build/src/server.js",
    "audit:production": "npm audit --omit=dev",
    "prelint": "CONFIG_FILE=${CONFIG_FILE:-config.example.yaml} tsoa spec-and-routes",
    "lint": "eslint .",
    "format": "prettier --write src/ test/",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": "true",
  "dependencies": {
    "@inversifyjs/binding-decorators": "^3.0.0",
    "@tsoa/runtime": "^6.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "inversify": "^8.2.3",
    "mongodb": "^7.6.0",
    "mudlet-map-binary-reader": "^2.0.0",
    "mudlet-map-browser-script": "^1.3.3",
    "mudlet-map-renderer": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "joi": "^18.2.9",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsoa": "^6.6.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
